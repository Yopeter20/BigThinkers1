# Copy this file to .env and fill in real values.
# Never commit your real .env file to GitHub.

SECRET_KEY=change-this-to-a-long-random-string

# Optional: needed only if you want BigThinkers AI to give real AI answers.
OPENAI_API_KEY=

# Main super administrator email (protected account)
MAIN_ADMIN_EMAIL=nkakapeter@gmail.com

# Outgoing email account used to send password-reset codes (Gmail SMTP).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=bigthinkersorganization@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_SENDER_NAME=BigThinkers
